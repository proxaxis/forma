{
  "scale": 1.0,
  "displayHeaderFooter": true,
  "printBackground": true,
  "landscape": false,
  "pageRanges": "1-5, 8",
  "format": "A4",
  "width": "210mm",
  "height": "297mm",
  "preferCSSPageSize": false,
  "margin": {
    "top": "20mm",
    "bottom": "20mm",
    "left": "15mm",
    "right": "15mm"
  },
  "omitBackground": false,
  "tagged": false,
  "outline": false,
  "timeout": 30000,
  "waitForFonts": true,
  "destination": ".",
  "browserArguments": [
    "--no-sandbox",
    "--disable-setuid-sandbox"
  ]
}
