{
  "name": "bolt-vsc-forma",
  "displayName": "Forma: Build Markdown Document",
  "description": "Let's create documents in Markdown!",
  "publisher": "proxaxis",
  "version": "0.0.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/proxaxis/forma"
  },
  "icon": "./public/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.136.0"
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "forma.preview",
        "title": "Forma: Open Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "forma.export",
        "title": "Forma: Export PDF",
        "icon": "$(file-pdf)"
      },
      {
        "command": "forma.initialization",
        "title": "Forma: Initialize Project Config"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "forma.preview",
          "when": "resourceLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "forma.export",
          "when": "resourceLangId == markdown",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Forma",
      "properties": {
        "forma.theme": {
          "description": "Theme files available to Forma.",
          "type": "object",
          "default": {
            "entry": "default.scss",
            "libraries": [
              { "name": "print", "path": "this-is-reserved-name" }
            ]
          }
        },
        "forma.parser": {
          "description": "Parser hooks available to Forma.",
          "type": "object",
          "default": {
            "entry": "parser.js",
            "libraries": []
          }
        },
        "forma.puppeteer": {
          "description": "PDF presets and Chromium settings for Forma.",
          "type": "object",
          "default": {
            "entry": "puppeteer.json",
            "libraries": [],
            "puppeteerRunnerPath": ""
          }
        },
        "forma.common.useAutoOpenPDF": {
          "description": "Open the exported PDF after it is created.",
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "vite build",
    "lint": "eslint src test eslint.config.mjs",
    "pretest": "npm run lint && npm run build",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.136.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.12.0",
    "vite": "^7.1.4"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.1",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-custom-block": "^1.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-imsize": "^2.0.1",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "prismjs": "^1.30.0",
    "puppeteer-core": "^25.10.0",
    "sass": "^1.104.0"
  }
}
